{
  "name": "tesseract",
  "version": "0.5.0",
  "description": "Graph-based code review for Plastic SCM / Unity Version Control and GitHub",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "Apache-2.0",
  "build": {
    "appId": "com.simteract.tesseract",
    "productName": "Tesseract",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json",
      "!node_modules/tree-sitter-cpp/{src,bindings,prebuilds,queries}/**",
      "!node_modules/tree-sitter-rust/{src,bindings,prebuilds,queries}/**"
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "Simteract",
      "repo": "tesseract",
      "releaseType": "release"
    },
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.11",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-rust": "^0.24.0",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cytoscape": "^3.34.4",
    "cytoscape-fcose": "^2.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
